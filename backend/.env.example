# Copy this file to `.env` and fill in the values.

# MongoDB connection. The bundled launcher (run.bat / run.py) starts a local
# MongoDB automatically at this URL. For a cloud DB, use a MongoDB Atlas string.
MONGO_URL="mongodb://localhost:27017"
DB_NAME="alphascribe"

# Comma-separated allowed origins for CORS. Must be explicit (not "*") since
# the auth session cookie requires allow_credentials — set this to wherever
# the frontend is served from.
CORS_ORIGINS="http://localhost:3001"

# LLM provider — powers extraction, synthesis, and fact-checking.
# Users can also paste their own key in the app UI (Sidebar → "LLM Key"),
# which overrides these for their requests. For a default/server key, set ONE:
#
# Option A — Google Gemini (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Option B — Groq (free, fast Llama): https://console.groq.com/keys
# GROQ_API_KEY=
# Option C — OpenAI (paid): https://platform.openai.com/api-keys
# OPENAI_API_KEY=
#
# Which provider the server default uses: gemini | groq | openai
LLM_PROVIDER=gemini

# Comma-separated emails allowed to use the "Custom" LLM provider (bring your
# own OpenAI-compatible endpoint). Everyone else won't see the option in the
# UI, and the server rejects it if requested directly. Set this to your own
# account's email to use it yourself; leave unset to disable it for everyone.
# ADMIN_EMAILS=you@example.com

# Custom (OpenAI-compatible) base URLs are blocked from resolving to
# localhost/private-network addresses by default (SSRF guard — see
# agents/llm.py assert_public_url), since even an admin's browser could be
# compromised or the base_url mistyped. Set this to true ONLY for a
# single-user/local instance you run yourself, e.g. to point the "Custom" LLM
# provider (see ADMIN_EMAILS above) at a local Ollama/LM Studio server.
# LLM_ALLOW_PRIVATE_BASE_URL=true

# Password-reset OTP email, sent via Resend (https://resend.com, free tier).
# Leave unset for local dev — the OTP is logged to the backend console instead
# of emailed, so the reset flow is still testable without a live account.
RESEND_API_KEY=
RESEND_FROM="AlphaScribe <onboarding@resend.dev>"

# HMAC pepper for hashing password-reset OTPs. A 6-digit code's hash is
# brute-forceable offline in under a second without this, so a leaked/read-only
# copy of the DB alone shouldn't be enough to recover a live OTP. Set a random
# secret string in production; the hardcoded fallback is dev-only and NOT secret.
OTP_PEPPER=
