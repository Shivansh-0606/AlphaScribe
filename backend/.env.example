# Copy this file to `.env` and fill in the values.

# MongoDB connection. The bundled launcher (run.bat / run.py) starts a local
# MongoDB automatically at this URL. For a cloud DB, use a MongoDB Atlas string.
MONGO_URL="mongodb://localhost:27017"
DB_NAME="alphascribe"

# Comma-separated allowed origins for CORS. "*" is fine for local development.
CORS_ORIGINS="*"

# Google Gemini API key — powers extraction, report synthesis, and fact-checking.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
